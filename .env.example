# ==============================================================================
# ArthaAI — Root Environment Configuration Reference
# ==============================================================================
# This file provides a centralized reference of environment variables used across
# the ArthaAI full-stack architecture (Render backend + Netlify frontend + MongoDB Atlas + Gemini).
#
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO VERSION CONTROL.
# Copy appropriate variables to backend/.env and frontend/.env respectively.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Configure in Render / backend/.env)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# MongoDB Atlas Database Connection URI (Supports MONGODB_URI or DATABASE_URL)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/artha_ai?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_URL=

# CORS & Allowed Origins (Comma-separated for multiple production frontend origins)
CLIENT_ORIGIN=https://artha-ai.netlify.app,http://localhost:5173

# Base API Route Prefix
API_PREFIX=/api

# Authentication & Session Security
# Generate a cryptographically strong 32+ character secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini Intelligence Engine (Official Google Gen AI SDK)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_OUTPUT_TOKENS=1500
AI_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Configure in Netlify / frontend/.env)
# ------------------------------------------------------------------------------
# In production on Netlify, set VITE_API_BASE_URL to your live Render backend URL:
# FORMAT RULES: No trailing slash, no '/api' suffix.
# Example: VITE_API_BASE_URL=https://artha-ai-backend.onrender.com
# In local development:
VITE_API_BASE_URL=http://localhost:5000
