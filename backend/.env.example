# ArthaAI Backend Environment Configuration Example
# Copy this file to .env and provide your specific environment values.

# Server Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI (MONGODB_URI or DATABASE_URL)
# Example: mongodb+srv://<username>:<password>@<cluster-url>/artha_ai?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_URL=

# Frontend Application Origin (for CORS, comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# Base API Route Prefix
API_PREFIX=/api

# Authentication & Security
# Generate a cryptographically secure random secret (min 32 characters in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# JWT Token Expiry (e.g. 15m, 1h, 1d, 7d)
JWT_EXPIRES_IN=7d

# Google Gemini Intelligence Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_OUTPUT_TOKENS=1500
AI_TEMPERATURE=0.3

