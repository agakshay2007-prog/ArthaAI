# ArthaAI Frontend Environment Configuration Example
# Copy this file to frontend/.env for local development or set in Netlify Environment Variables.

# Backend API Base URL
# For local development with Vite dev server (or leave empty if using Vite proxy):
VITE_API_BASE_URL=http://localhost:5000

# For production on Netlify, point to your live deployed Render backend URL:
# VITE_API_BASE_URL=https://artha-ai-api.onrender.com
